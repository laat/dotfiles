[user]
	name = Sigurd Fosseng
	email = sigurd@fosseng.net
[diff]
	algorithm = histogram
	colorMoved = default
[color]
	diff = auto
	status = auto
	branch = auto
	ui = true
[alias]
	# Resolves the default branch from the cached refs/remotes/origin/HEAD (no
	# network). Note: `git fetch` does not refresh that ref, so if the remote's
	# default branch is renamed, run `git remote set-head origin -a` once.
	main = "!f() { \
		b=$(git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null) \
		|| b=$(git remote set-head origin -a >/dev/null 2>&1 && git symbolic-ref refs/remotes/origin/HEAD --short 2>/dev/null) \
		|| b=$(git remote show origin | sed -n '/HEAD branch/s/.*: //p'); \
		[ -n \"$b\" ] || { echo 'git main: could not determine default branch' >&2; exit 1; }; \
		git checkout \"${b#origin/}\"; \
	}; f"
	m = main
	co = checkout
	ci = commit
	cis = commit -S
	st = status
	br = branch
	l = log --stat --abbrev-commit
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	lol = log --graph --decorate --pretty=oneline --abbrev-commit --all
	d = diff
	dc = diff --cached
	panic = !tar cvf ../git_panic.tar *
	changelog = !git-changelog
	ignore = "!gi() { curl -L -s https://www.gitignore.io/api/$@ | sed '/^# .*toptal/d' ;}; gi"
	cai = !git-aia
	ai = !git-ai
[include] # silent fail
	path = /etc/gitconfig
	path = .gitconfig.osx
	path = .gitconfig.linux
	path = .gitconfig.local
	path = ~/.gitconfig.local
[push]
	default = simple
	autoSetupRemote = true
[core]
	autocrlf = input
	excludesfile = ~/.gitignore_global
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[magit]
	hideCampaign = true
[diff "sopsdiffer"]
	textconv = sops -d
[github]
	user = laat
[diff "orgmode"]
	xfuncname = "^(\\*+.*)$"
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[fetch]
	prune = true
[log]
	abbrevCommit = true
[branch]
	sort = -committerdate
[pull]
	rebase = true
[init]
	defaultBranch = main	
