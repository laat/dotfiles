#!/bin/sh
# Run a coding agent under agent-safehouse (sandbox-exec) with the grants this
# machine needs on top of safehouse's defaults:
#
# - ~/.dotfiles and any ~/.dotfiles-* sibling repo read-only: ~/.gitconfig,
#   ~/.config/workmux/config.yaml, the skills under ~/.claude/skills and the
#   rest of the stowed config are symlinks into them, and sandbox-exec
#   resolves symlinks before checking the policy, so git fails without it.
# - ~/code and ~/git read-write: one session often opens PRs in several
#   repos. Everything else under $HOME stays hidden.
# - ~/.local/bin read-only: safehouse only lets the sandbox list it and grants
#   single binaries per agent profile, so `command -v workmux` fails and every
#   hook in ~/.claude/settings.json dies with "workmux: command not found".
# - workmux state and cache dirs, the tmux socket (agents.sb) and the TMUX and
#   TMUX_PANE variables: those hooks call `workmux set-window-status` from
#   inside the agent, and without these they fail silently and the sidebar,
#   dashboard and `workmux wait` never update.
# - .env files git tracks in the workdir's repo are readable. agents.sb denies
#   every .env so gitignored secrets stay hidden, but a committed .env is
#   already public to anyone with the repo (typically ports and emulator
#   hosts for local dev), and denying it only breaks the agent. A
#   repo-level .safehouse cannot lift the deny because safehouse applies it
#   before the CLI --append-profile files, so the exception lives here.
# - When ~/.config/safehouse/npmrc exists (setup/npm-readonly-token), npm and
#   pnpm use its read-only token via npm_config_userconfig and the real
#   ~/.npmrc is hidden (npm.sb). Without it, safehouse's default applies and
#   the agent sees ~/.npmrc.
# - Whatever the drop-ins in ~/.config/safehouse/agent.d/*.sh add, for
#   grants kept in private dotfiles.
# - safehouse's 1password feature: ~/.gitconfig signs commits with op-ssh-sign
#   over the 1Password agent socket, which the default policy denies, so every
#   commit failed with "1Password: Could not connect to socket". The keys in
#   ~/.ssh stay denied; the grant is the socket, the app bundle and
#   ~/.config/1Password.
# - GIT_SSH_COMMAND for git over ssh: ControlMaster off, the 1Password agent
#   as identity source and a copy of the host's known_hosts, since the keys in
#   ~/.ssh are denied, known_hosts is read-only and the host's ControlMaster
#   socket must not be shared (it is a pre-authenticated session). See the
#   comment at the definition.
# - safehouse's shell-init feature: SHELL inside the sandbox is bash, and
#   Claude Code's shell snapshot runs it interactively, which sources
#   ~/.bashrc and printed "~/.bashrc: Operation not permitted" on every
#   start. The feature grants only the top-level rc files; agents.sb adds
#   what they source (~/.shrc, ~/.shrc.d, ~/.profile.local, the *.local
#   files) so aliases and functions load inside, and denies
#   ~/.profile.local-secrets, where the host's tokens live.
# - ~/.codex read-write for agents other than codex, except its config and
#   what it runs as code (codex.sb), and when the wrapper runs inside the
#   sandbox it starts the agent directly instead of nesting a second
#   sandbox: a sandboxed claude asking codex for a review failed because
#   safehouse grants each agent only its own state and Seatbelt can't apply
#   a policy inside another. Every sandboxed agent can read codex's login
#   (auth.json). See the comments at the definitions.
#
#   safehouse-agent <agent> [args...]
#   <agent>-safe [args...]         symlink to this script, agent from the name
#
# The agent's safehouse profile (keychain, ~/.claude, ...) is picked from the
# command's basename, so the agent must be the bare command name.
set -eu

case $(basename "$0") in
  *-safe) agent=${0##*/}; agent=${agent%-safe} ;;
  *) agent=$1; shift ;;
esac

# Already inside the sandbox: an agent running another agent, such as claude
# asking codex for a review. Seatbelt can't apply a second policy inside the
# first (sandbox_apply: Operation not permitted), so run the agent directly
# under the outer policy, which grants its state below. SAFEHOUSE_AGENT is
# set for processes this wrapper starts; the probe checks that the sandbox is
# really there, so a SAFEHOUSE_AGENT leaked to the host can't skip it.
# codex's own sandbox is Seatbelt too and fails the same way, so it is turned
# off with -c, which unlike --dangerously-bypass-approvals-and-sandbox also
# reaches subcommands such as codex review.
if [ -n "${SAFEHOUSE_AGENT:-}" ] &&
  ! sandbox-exec -p '(version 1)(allow default)' /usr/bin/true 2>/dev/null; then
  case $agent in
    codex) set -- -c sandbox_mode=danger-full-access -c approval_policy=never "$@" ;;
  esac
  exec "$agent" "$@"
fi
export SAFEHOUSE_AGENT="$agent"

conf=$HOME/.config/safehouse
ro="${DOTFILES_DIR:-$HOME/.dotfiles}:$HOME/.local/bin"
for d in "$HOME"/.dotfiles-*; do
  [ -d "$d" ] && ro="$ro:$d"
done
env_pass=TMUX,TMUX_PANE,SAFEHOUSE_AGENT

# ~/.cache/claude-statusline: ~/.claude/statusline.sh caches the Fable usage
# window there; safehouse only allows listing ~/.cache.
mkdir -p "$HOME/.local/state/workmux" "$HOME/.cache/workmux" "$HOME/.cache/claude-statusline"
rw="$HOME/.local/state/workmux:$HOME/.cache/workmux:$HOME/.cache/claude-statusline"
# Only dirs that exist on this machine; safehouse warns about missing ones.
for d in "$HOME/code" "$HOME/git"; do
  [ -d "$d" ] && rw="$rw:$d"
done

# Drop-ins from other stow packages (e.g. a private ~/.dotfiles-* repo) for grants that
# don't belong in this public repo. Sourced with this script's variables in
# scope; they append to ro and rw (colon-separated) and env_pass
# (comma-separated). ~/.config/safehouse is not writable from inside the
# sandbox, so a sandboxed agent cannot add one.
for f in "$conf"/agent.d/*.sh; do
  [ -f "$f" ] && . "$f"
done

# git over ssh. safehouse lets the sandbox read ~/.ssh/config and
# ~/.ssh/known_hosts but nothing else in ~/.ssh, so ssh has no key and cannot
# add to known_hosts, and core.sshCommand in ~/.gitconfig points it at a
# ControlMaster socket it cannot bind (ssh exits 255 on that). Give git its
# own ssh command: no ~/.ssh/config and ControlMaster off, so the sandbox
# never reuses a master the host already authenticated; the 1Password agent
# as the identity source (the 1password feature grants the socket), so every
# push authenticates through 1Password like commit signing does; and a copy
# of the host's known_hosts it can read and extend. Costs the handshake on
# every remote operation.
op_sock=$(printf '%s\n' "$HOME"/Library/Group\ Containers/*.com.1password/t/agent.sock | head -1)
known_hosts=$(mktemp -t safehouse-known-hosts)
cat "$HOME/.ssh/known_hosts" > "$known_hosts" 2>/dev/null || true
export GIT_SSH_COMMAND="ssh -F /dev/null -o ControlMaster=no -o 'IdentityAgent=\"$op_sock\"' -o UserKnownHostsFile=$known_hosts -o StrictHostKeyChecking=accept-new"
env_pass="$env_pass,GIT_SSH_COMMAND"

# mise shims last on PATH. The shell startup files only activate mise when it
# lives in ~/.local/bin, and here it comes from Homebrew, so on the host
# terraform resolves to ~/bin/terraform, which the sandbox hides. Appended so
# tools the host already resolves keep resolving the same way.
[ -d "$HOME/.local/share/mise/shims" ] && export PATH="$PATH:$HOME/.local/share/mise/shims"

# Optional flags go in front of the agent command.
set -- -- "$agent" "$@"
if [ -f "$conf/npmrc" ]; then
  ro="$ro:$conf/npmrc"
  export npm_config_userconfig="$conf/npmrc"
  env_pass="$env_pass,npm_config_userconfig"
  set -- --append-profile="$conf/npm.sb" "$@"
fi

# ~/.codex for the other agents, so one can run codex (claude asking it for a
# review). safehouse grants it only to codex's own sandbox, and codex writes
# its sessions, databases and refreshed tokens there. codex.sb denies writes
# to its config and to files it runs as code, which an unsandboxed codex on
# the host would pick up.
if [ "$agent" != codex ] && [ -d "$HOME/.codex" ]; then
  rw="$rw:$HOME/.codex"
  set -- --append-profile="$conf/codex.sb" "$@"
fi

# Allow the .env files git tracks, appended after agents.sb so the allow wins.
# safehouse takes the workdir from the cwd, so look up the repo root from there.
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
  tracked=$(git -C "$top" ls-files --full-name | grep -E '(^|/)\.env(\.[^/]*)?$' || true)
  if [ -n "$tracked" ]; then
    envsb=$(mktemp -t safehouse-tracked-env)
    {
      echo ";; .env files tracked by git in $top, generated by safehouse-agent."
      echo ";; Overrides the .env deny in agents.sb; gitignored .env files stay hidden."
      printf '%s\n' "$tracked" | sed -e 's/[\\"]/\\&/g' -e "s|.*|(allow file-read* (literal \"$top/&\"))|"
    } > "$envsb"
    set -- --append-profile="$envsb" "$@"
  fi
fi

exec safehouse \
  --enable=1password,shell-init,clipboard \
  --add-dirs-ro="$ro" \
  --add-dirs="$rw" \
  --append-profile="$conf/agents.sb" \
  --env-pass="$env_pass" \
  "$@"
