#!/bin/sh
# Run a coding agent under agent-safehouse (sandbox-exec) with the grants this
# machine needs on top of safehouse's defaults:
#
# - ~/.dotfiles read-only: ~/.gitconfig, ~/.config/workmux/config.yaml and the
#   rest of the stowed config are symlinks into it, and sandbox-exec resolves
#   symlinks before checking the policy, so git fails without it.
# - ~/code and ~/git read-write: one session often opens PRs in several
#   repos. Everything else under $HOME stays hidden.
# - ~/.local/bin read-only: safehouse only lets the sandbox list it and grants
#   single binaries per agent profile, so `command -v workmux` fails and every
#   hook in ~/.claude/settings.json dies with "workmux: command not found".
# - workmux state and cache dirs, the tmux socket (agents.sb) and the TMUX and
#   TMUX_PANE variables: those hooks call `workmux set-window-status` from
#   inside the agent, and without these they fail silently and the sidebar,
#   dashboard and `workmux wait` never update.
# - .env files git tracks in the workdir's repo are readable. agents.sb denies
#   every .env so gitignored secrets stay hidden, but a committed .env is
#   already public to anyone with the repo (typically ports and emulator
#   hosts for local dev), and denying it only breaks the agent. A
#   repo-level .safehouse cannot lift the deny because safehouse applies it
#   before the CLI --append-profile files, so the exception lives here.
# - When ~/.config/safehouse/npmrc exists (setup/npm-readonly-token), npm and
#   pnpm use its read-only token via npm_config_userconfig and the real
#   ~/.npmrc is hidden (npm.sb). Without it, safehouse's default applies and
#   the agent sees ~/.npmrc.
# - safehouse's 1password feature: ~/.gitconfig signs commits with op-ssh-sign
#   over the 1Password agent socket, which the default policy denies, so every
#   commit failed with "1Password: Could not connect to socket". ~/.ssh stays
#   hidden; the grant is the socket, the app bundle and ~/.config/1Password.
#
#   safehouse-agent <agent> [args...]
#   <agent>-safe [args...]         symlink to this script, agent from the name
#
# The agent's safehouse profile (keychain, ~/.claude, ...) is picked from the
# command's basename, so the agent must be the bare command name.
set -eu

case $(basename "$0") in
  *-safe) agent=${0##*/}; agent=${agent%-safe} ;;
  *) agent=$1; shift ;;
esac

conf=$HOME/.config/safehouse
ro="${DOTFILES_DIR:-$HOME/.dotfiles}:$HOME/.local/bin"
env_pass=TMUX,TMUX_PANE

# ~/.cache/claude-statusline: ~/.claude/statusline.sh caches the Fable usage
# window there; safehouse only allows listing ~/.cache.
mkdir -p "$HOME/.local/state/workmux" "$HOME/.cache/workmux" "$HOME/.cache/claude-statusline"
rw="$HOME/.local/state/workmux:$HOME/.cache/workmux:$HOME/.cache/claude-statusline"
# Only dirs that exist on this machine; safehouse warns about missing ones.
for d in "$HOME/code" "$HOME/git"; do
  [ -d "$d" ] && rw="$rw:$d"
done

# Optional flags go in front of the agent command.
set -- -- "$agent" "$@"
if [ -f "$conf/npmrc" ]; then
  ro="$ro:$conf/npmrc"
  export npm_config_userconfig="$conf/npmrc"
  env_pass="$env_pass,npm_config_userconfig"
  set -- --append-profile="$conf/npm.sb" "$@"
fi

# Allow the .env files git tracks, appended after agents.sb so the allow wins.
# safehouse takes the workdir from the cwd, so look up the repo root from there.
if top=$(git rev-parse --show-toplevel 2>/dev/null); then
  tracked=$(git -C "$top" ls-files --full-name | grep -E '(^|/)\.env(\.[^/]*)?$' || true)
  if [ -n "$tracked" ]; then
    envsb=$(mktemp -t safehouse-tracked-env)
    {
      echo ";; .env files tracked by git in $top, generated by safehouse-agent."
      echo ";; Overrides the .env deny in agents.sb; gitignored .env files stay hidden."
      printf '%s\n' "$tracked" | sed -e 's/[\\"]/\\&/g' -e "s|.*|(allow file-read* (literal \"$top/&\"))|"
    } > "$envsb"
    set -- --append-profile="$envsb" "$@"
  fi
fi

exec safehouse \
  --enable=1password \
  --add-dirs-ro="$ro" \
  --add-dirs="$rw" \
  --append-profile="$conf/agents.sb" \
  --env-pass="$env_pass" \
  "$@"
