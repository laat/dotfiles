#!/bin/sh
# Kill any workmux sidebar pane left alone in its window, so the window (and
# in session mode the session) closes as soon as the last real pane exits.
#
# workmux only notices this on its 2s daemon poll, since tmux fires none of
# its hooks when a program exits on its own. Called from the pane-exited hook
# in ~/.tmux.conf. That hook runs after the pane is gone and its pane formats
# point at whatever pane is active (possibly in another session), so scan
# every window rather than trusting the hook context.
sleep 0.02
tmux list-panes -a -F '#{window_panes} #{pane_id} #{@workmux_role}' \
  | awk '$1 == 1 && $3 == "sidebar" { print $2 }' \
  | xargs -n1 tmux kill-pane -t 2>/dev/null
exit 0
